# ---------------------------------------------------------------------------
# JobShield AI environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SERVER ONLY. Used exclusively for account deletion (auth.admin.deleteUser).
# Optional: without it, users can still delete all of their data, but not the
# auth account itself. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API keys) --------------------------
# SERVER ONLY. Without it, scans run in clearly labelled "rules-only" mode.
ANTHROPIC_API_KEY=
# Model used for analysis. Must support structured outputs (output_config.format).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Effort level: low | medium | high
ANTHROPIC_EFFORT=medium
# Max output tokens for one analysis call
ANTHROPIC_MAX_OUTPUT_TOKENS=4000

# --- Testing only ------------------------------------------------------------
# When "1", the analyzer returns deterministic fixture output labelled "Mock AI"
# instead of calling Claude. Refused when VERCEL_ENV=production.
JOBSHIELD_MOCK_AI=0
